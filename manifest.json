{
  "manifest_version": 3,
  "name": "Monday.com CRM Data Extractor",
  "version": "1.0.0",
  "description": "Extract CRM data from Monday.com boards",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": ["https://*.monday.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.monday.com/*"],
      "js": [
        "content/content.js",

        "content/extractors/contacts.js",
        "content/extractors/leads.js",
        "content/extractors/deals.js",
        "content/extractors/activities.js",

        "content/storage.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
